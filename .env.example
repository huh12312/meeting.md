# Use a published image instead of building ./server (see README, "Releases").
#MEETING_MD_IMAGE=

# ---- Access -----------------------------------------------------------------
# Comma-separated keys users type into the app. Leave empty and the server
# generates one on first start and prints it (docker compose logs server).
API_KEYS=

# How the app and the capture client reach this stack. Change `localhost` to
# the host's name or address when the app runs on another machine.
PUBLIC_URL=http://localhost:8080
# rtsp:// for the Linux capture helper. The stock macOS/Windows capture binary
# only accepts rtsps://<host>:8322 (see README, "macOS and Windows").
RTSP_PUBLISH_URL=rtsp://localhost:8554

# ---- LLM (summaries, live assist, MCP agent, visual analysis) ---------------
# Pick one provider. The app asks for tiers "basic" / "pro" / "ultra";
# LLM_MODEL answers all three unless the per-tier variables below are set.
#
#   openai       any OpenAI-compatible /chat/completions endpoint
#                  LLM_BASE_URL=http://ollama:11434/v1            (--profile ollama)
#                  LLM_BASE_URL=http://host.docker.internal:11434/v1  (Ollama on the host)
#   openrouter   LLM_API_KEY=<OpenRouter key>, LLM_MODEL=<an OpenRouter model id>
#   anthropic    ANTHROPIC_API_KEY=<key>; LLM_MODEL defaults to claude-opus-5-5
#   claude-code  ANTHROPIC_API_KEY=<key>; runs the bundled Claude Code CLI per request
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
#LLM_MODEL_BASIC=
#LLM_MODEL_PRO=
#LLM_MODEL_ULTRA=
# Needs image input; only used when "Visual Analysis" is switched on.
#LLM_MODEL_VISION=

# anthropic / claude-code only
#ANTHROPIC_API_KEY=
# Reasoning effort: low | medium | high | xhigh | max. Lower is faster, which
# matters for live assist. Default medium (anthropic) / CLI default (claude-code).
#LLM_EFFORT=medium

# ---- Speech to text ---------------------------------------------------------
# Any OpenAI-compatible /audio/transcriptions endpoint.
STT_BASE_URL=http://stt:8000/v1
STT_API_KEY=
# base.en keeps up with two live channels on a desktop CPU (about 2 s behind).
# Use Systran/faster-whisper-base for other languages. small and larger are
# more accurate but need a GPU to stay real time; the server logs a warning
# when transcription falls behind.
STT_MODEL=Systran/faster-whisper-base.en
# Names and jargon Whisper should expect, e.g. "Acme, Kubernetes, Priya".
#STT_PROMPT=
